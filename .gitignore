# RPM build artifacts
*.rpm
*.src.rpm
BUILD/
BUILDROOT/
RPMS/
SRPMS/
SOURCES/*.tar.gz
SOURCES/*.tar.xz

# Local mock build output (RPMs, vendor tarballs, generated repo metadata) - not source,
# regenerable from specs/, kept locally on durin only
/built-rpms/

# Large upstream main-source tarballs (multi-ten-MB+) stay local, refetched via `spectool -g` as
# needed - small ones (a few hundred KB to low single-digit MB) get committed under specs/ for
# reproducibility, but this one and the ghostty zig-vendor cache are too big to be worth it.
specs/hyprland/Hyprland-*.tar.gz
specs/zig/zig-*.tar.xz

# Prebuilt shader-slang compiler release tarballs - build-time tool only,
# re-fetched from shader-slang's own GitHub releases, too big to be worth
# committing (same reasoning as the ghostty zig-vendor cache above)
specs/kitty/slang-*.tar.gz
# kitty's own main source tarball (12MB - bigger than this repo's usual
# committed-source threshold), refetched via its own release URL as needed.
# (kitty-vendor.tar.xz, the small regenerated go-vendor-tools archive, stays
# committed - this pattern is version-numbered so it doesn't match that.)
specs/kitty/kitty-[0-9]*.tar.xz

# cargo vendor caches - regenerable from Cargo.lock via `cargo vendor`, too big to be worth
# committing (same reasoning as the ghostty zig-vendor cache above)
specs/alacritty/alacritty-*-vendor.tar.gz

# Mock chroot state
/var/lib/mock/

# Local editor/OS cruft
*.swp
.DS_Store
